# Optional. Leave empty to use OpenStreetMap's public raster tiles (their usage policy limits heavy use).
# For anything beyond local testing, point this at a tile provider you have rights to use, for example
# https://{s}.tile.example.com/{z}/{x}/{y}.png  (use {z}/{x}/{y} only; replace {s} with your provider's subdomain format)
# Vite exposes only variables that start with VITE_.
VITE_TILE_URL=
